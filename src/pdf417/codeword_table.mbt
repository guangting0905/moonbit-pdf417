///|
/// Number of distinct codeword values (0..928).
pub let codeword_count : Int = 929

///|
/// Maximum number of codewords a symbol can hold, including the length
/// descriptor, data, padding and error correction.
pub let max_codewords : Int = 928

///|
/// Integrity check on the generated pattern table. Returns the number of
/// patterns verified.
///
/// Every entry must be 17 modules, alternate bar/space starting with a bar,
/// have 8 runs each 1..6 modules wide, and satisfy the cluster formula.
pub fn check_pattern_table() -> Int raise {
  let mut checked = 0
  for t = 0; t < 3; t = t + 1 {
    let want_cluster = 3 * t
    if patterns[t].length() != codeword_count {
      fail("cluster \{t}: \{patterns[t].length()} patterns, want \{codeword_count}")
    }
    for w = 0; w < codeword_count; w = w + 1 {
      let v = patterns[t][w]
      // 17 modules: the top 15 bits must contain a set bit, bit 16 must be set.
      if (v >> 16) != 1U {
        fail("cluster \{t} word \{w}: top bit not set, not a 17-module pattern")
      }
      if (v & 0x1FFFFU) != v {
        fail("cluster \{t} word \{w}: wider than 17 modules")
      }
      let bars : Array[Int] = []
      let spaces : Array[Int] = []
      let mut on_bar = true
      let mut n = 0
      for i = 16; i >= 0; i = i - 1 {
        let bit = ((v >> i) & 1U) == 1U
        if bit == on_bar {
          n = n + 1
        } else {
          if on_bar {
            bars.push(n)
          } else {
            spaces.push(n)
          }
          on_bar = bit
          n = 1
        }
      }
      if on_bar {
        bars.push(n)
      } else {
        spaces.push(n)
      }
      if bars.length() != 4 || spaces.length() != 4 {
        fail("cluster \{t} word \{w}: wants 4 bars and 4 spaces")
      }
      for i = 0; i < 4; i = i + 1 {
        if bars[i] < 1 || bars[i] > 6 || spaces[i] < 1 || spaces[i] > 6 {
          fail("cluster \{t} word \{w}: run width out of 1..6")
        }
      }
      let raw = bars[0] - bars[1] + bars[2] - bars[3]
      let k = ((raw % 9) + 9) % 9
      if k != want_cluster {
        fail("cluster \{t} word \{w}: cluster formula gives \{k}")
      }
      checked = checked + 1
    }
  }
  checked
}
