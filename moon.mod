name = "guangting0905/moonbit-pdf417"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/guangting0905/moonbit-pdf417"

license = "Apache-2.0"

keywords = [ "pdf417", "barcode", "iso-15438", "reed-solomon", "ecma", "encoder" ]

preferred_target = "wasm"

description = "PDF417 (ISO/IEC 15438) two-dimensional barcode encoder and decoder in pure MoonBit: Reed-Solomon over GF(929), three compaction modes, and a module-matrix decoder."
